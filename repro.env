# Source this before running anything: source repro.env
# slurm/submit_full_run.sh and slurm/full_run.sbatch read the MLSTEP_* variables.
export MLSTEP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
export MLSTEP_DATA_DIR=/rds/project/rds-jzEwvbIgOag/users/jw2423

# Large files stay out of the home quota.
export MLSTEP_WORK="/rds/user/$USER/hpc-work"
export MLSTEP_OUTPUTS="$MLSTEP_WORK/mlstep-outputs"
export MLSTEP_CONDA_BASE="$MLSTEP_WORK/miniforge3"
export MLSTEP_CONDA_SH="$MLSTEP_CONDA_BASE/etc/profile.d/conda.sh"
export MLSTEP_CONDA_ENV=mlstep
